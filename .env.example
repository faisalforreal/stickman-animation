# ==============================================================================
# Stickman Animation: TTS Narration & AutoCaptions Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Text-to-Speech (TTS) Configuration
# ------------------------------------------------------------------------------
# Provider: 'gemini' (default), 'openai', 'elevenlabs', or 'custom'
TTS_PROVIDER=gemini

# API Key (for Gemini, set GEMINI_API_KEY or TTS_API_KEY)
TTS_API_KEY=your_gemini_api_key_here

# Speech Model:
# For Gemini: gemini-3.8-flash-tts, gemini-2.5-flash, gemini-2.0-flash
# For OpenAI: tts-1, tts-1-hd
TTS_MODEL=gemini-3.8-flash-tts

# Voice:
# For Gemini: Charon (default), Puck, Kore, Fenrir, Aoede
# For OpenAI: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=Charon

# Optional: Custom API Endpoint URL override
# Default for Gemini: https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
TTS_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

# ------------------------------------------------------------------------------
# 2. Captions & Styling Configuration (AutoCaptions Engine)
# ------------------------------------------------------------------------------
# Subtitle Style Preset:
# Curated options:
#   hormozi-bold        (Massive uppercase, electric yellow highlight, black outline)
#   mrbeast-pop         (High energy, neon green highlight, comic stroke)
#   ali-abdaal-clean    (Dark rounded pill badge, sky blue highlight)
#   cyberpunk-neon      (Electric cyan & neon pink glow)
#   dev-minimal         (Monospace terminal pill badge, emerald highlight)
#   karaoke-gold        (Horizontal gold karaoke wipe)
#   luxury-editorial    (Serif typography, champagne gold)
#   bold_red_accent     (Bold white with crimson red highlight)
#   boxed_green_accent  (Dark badge with neon green highlight)
# Or any of the 400+ CapCut preset IDs (run `stickman presets` to view all)
CAPTION_STYLE=hormozi-bold

# Subtitle Vertical Position (percent from top):
# 75.0 = 75% distance from top (25% from bottom, recommended default)
# 50.0 = centered in middle of screen
# 20.0 = top third
CAPTION_POS_Y=75.0

# Optional: Deepgram API Key for millisecond-precision audio transcription
# (If omitted, natural speech-syllable timing estimation is used automatically)
DEEPGRAM_API_KEY=
